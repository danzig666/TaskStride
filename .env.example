# Browser bundle (inlined by Vite at build time - never put a secret here)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_APP_NAME=TaskStride
VITE_APP_BASE_PATH=/
VITE_SOURCE_URL=https://github.com/danzig666/TaskStride
VITE_MOCK_MODE=true

# Authorization backend (functions/), runtime only - set these as Cloudflare Pages secrets.
# Without them the app falls back to the one-hour in-tab token flow.
# See docs/cloudflare-setup.md
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
SESSION_SECRET=generate-with-openssl-rand-base64-48
